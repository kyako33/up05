    def create_main_frames(self):
        """Создание основных фреймов"""
        # Главный контейнер
        self.main_container = tk.Frame(self.root, bg=self.colors['bg'])
        self.main_container.pack(fill=tk.BOTH, expand=True)
        
        # Верхняя панель с заголовком
        self.header = tk.Frame(self.main_container, bg=self.colors['bg'], height=60)
        self.header.pack(fill=tk.X, pady=(10, 0))
        self.header.pack_propagate(False)
        
        self.title = tk.Label(
            self.header, 
            text="NONOGRAM", 
            font=("Arial", 28, "bold"),
            fg=self.colors['accent'],
            bg=self.colors['bg']
        )
        self.title.pack()
        
        # Контентная область
        self.content_area = tk.Frame(self.main_container, bg=self.colors['bg'])
        self.content_area.pack(fill=tk.BOTH, expand=True, padx=30, pady=10)
    
    def clear_content(self):
        """Очистка контентной области"""
        for widget in self.content_area.winfo_children():
            widget.destroy()
    
