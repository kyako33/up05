        elif self.current_screen == "settings":
            self.show_settings()
        elif self.current_screen == "game" and self.current_level is not None:
            self.show_game_screen()
    
    def reset_progress(self):
        """Сброс прогресса всех уровней"""
        if messagebox.askyesno("Сброс прогресса", "Вы уверены, что хотите сбросить прогресс всех уровней?"):
            self.completed_levels = {}
            self.save_completed_levels()
            self.show_levels()
            messagebox.showinfo("Успех", "Прогресс успешно сброшен!")
    
    def calculate_hints(self, grid):
        """Вычисление подсказок"""
        rows_hints = []
        for row in grid:
            hints = []
            count = 0
            for cell in row:
                if cell == 1:
                    count += 1
                elif count > 0:
                    hints.append(count)
                    count = 0
            if count > 0:
                hints.append(count)
            rows_hints.append(hints if hints else [0])
        
        cols_hints = []
        for col in range(len(grid[0])):
            hints = []
            count = 0
            for row in range(len(grid)):
                if grid[row][col] == 1:
                    count += 1
                elif count > 0:
                    hints.append(count)
                    count = 0
            if count > 0:
                hints.append(count)
            cols_hints.append(hints if hints else [0])
        
        return rows_hints, cols_hints
    
    def check_row_errors(self, row):
        """Проверка строки на ошибки"""
        if not self.show_hints:
            return False
        
        for col in range(self.cols):
            if self.user_grid[row][col] == 1 and self.grid_data[row][col] != 1:
                return True
        return False
    
    def check_col_errors(self, col):
        """Проверка столбца на ошибки"""
        if not self.show_hints:
            return False
        
        for row in range(self.rows):
            if self.user_grid[row][col] == 1 and self.grid_data[row][col] != 1:
                return True
        return False
    
    def start_level(self, level_idx):
        """Начало уровня"""
        self.current_level = self.levels[level_idx]
        self.current_level_index = level_idx
        self.grid_data = self.current_level["solution"]
        self.rows = len(self.grid_data)
        self.cols = len(self.grid_data[0])
        
        max_width = self.root.winfo_width() - 200
        max_height = self.root.winfo_height() - 150
        
        self.cell_size = min(35, max_width // self.cols, max_height // self.rows)
        if self.cell_size < 20:
            self.cell_size = 20
        
        self.user_grid = [[0 for _ in range(self.cols)] for _ in range(self.rows)]
        self.rows_hints, self.cols_hints = self.calculate_hints(self.grid_data)
        
        self.show_game_screen()
    
