import tkinter as tk
from tkinter import messagebox, ttk
import json
import os

class ModernNonogram:
    def __init__(self, root):
        self.root = root
        self.root.title("Нонограмм")
        self.root.geometry("900x700")
        
        # Данные игры
        self.current_level = None
        self.grid_data = None
        self.user_grid = None
        self.rows_hints = []
        self.cols_hints = []
        self.cell_size = 30
        self.show_hints = True
        self.current_theme = "dark"
        self.current_screen = "start"
        
        # Отслеживание пройденных уровней
        self.completed_levels = self.load_completed_levels()
        
        # Загрузка уровней
        self.levels = self.load_levels()
        
        # Создание интерфейса
        self.setup_styles()
        self.create_main_frames()
        self.show_start_screen()
    
    def load_completed_levels(self):
        """Загрузка информации о пройденных уровнях"""
        if os.path.exists("completed_levels.json"):
            try:
                with open("completed_levels.json", "r", encoding="utf-8") as f:
                    return json.load(f)
            except:
                return {}
        return {}
    
    def save_completed_levels(self):
        """Сохранение информации о пройденных уровнях"""
        with open("completed_levels.json", "w", encoding="utf-8") as f:
            json.dump(self.completed_levels, f, ensure_ascii=False, indent=2)
    
    def setup_styles(self):
        """Настройка стилей в зависимости от темы"""
        if self.current_theme == "dark":
            self.colors = {
                'bg': '#1a1a2e',
                'card': '#16213e',
                'card_hover': '#1e2a4a',
                'accent': '#e94560',
                'accent_hover': '#ff6b81',
                'text': '#ffffff',
                'text_secondary': '#a0a0a0',
                'button': '#0f3460',
                'button_hover': '#1a4a7a',
                'grid_bg': '#2a2a3e',
                'grid_line': '#3a3a4e',
                'grid_cell': '#e94560',
                'error': '#ff0000'
            }
        else:
            self.colors = {
                'bg': '#f0f0f0',
                'card': '#ffffff',
                'card_hover': '#e8e8e8',
                'accent': '#4a90e2',
                'accent_hover': '#6ba8ff',
                'text': '#333333',
                'text_secondary': '#666666',
                'button': '#e0e0e0',
                'button_hover': '#d0d0d0',
                'grid_bg': '#ffffff',
                'grid_line': '#cccccc',
                'grid_cell': '#4a90e2',
