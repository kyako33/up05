    def create_level_card_grid(self, parent, level_data, index):
        """Создание карточки уровня в виде сетки (как на картинке)"""
        card = tk.Frame(
            parent,
            bg=self.colors['card'],
            relief=tk.FLAT,
            bd=1,
            highlightbackground=self.colors['grid_line'],
            highlightthickness=1,
            width=180,
            height=160
        )
        card.pack_propagate(False)
        card.pack(side=tk.LEFT, padx=10, pady=10)
        
        # Внутренний контент
        inner_frame = tk.Frame(card, bg=self.colors['card'])
        inner_frame.pack(fill=tk.BOTH, expand=True, padx=15, pady=15)
        
        # Название уровня
        name_label = tk.Label(
            inner_frame,
            text=level_data['name'],
            font=("Arial", 14, "bold"),
            fg=self.colors['text'],
            bg=self.colors['card']
        )
        name_label.pack(pady=(0, 5))
        
        # Размер уровня
        size_text = f"{level_data['rows']}x{level_data['cols']}"
        size_label = tk.Label(
            inner_frame,
            text=size_text,
            font=("Arial", 10),
            fg=self.colors['text_secondary'],
            bg=self.colors['card']
        )
        size_label.pack()
        
        # Сложность
        difficulty_label = tk.Label(
            inner_frame,
            text=level_data['difficulty'],
            font=("Arial", 9),
            fg=self.colors['accent'],
            bg=self.colors['card']
        )
        difficulty_label.pack(pady=(5, 10))
        
        level_id = str(level_data['id'])
        is_completed = level_id in self.completed_levels
        
        # Статус прохождения
        if is_completed:
            status_label = tk.Label(
                inner_frame,
                text="✓ ПРОЙДЕН",
                font=("Arial", 9, "bold"),
                fg=self.colors['accent'],
                bg=self.colors['card']
            )
            status_label.pack(pady=(0, 5))
            
            play_btn = tk.Button(
                inner_frame,
                text="ПОВТОРИТЬ",
                font=("Arial", 9, "bold"),
                bg=self.colors['button'],
                fg=self.colors['text'],
                relief=tk.FLAT,
                cursor="hand2",
                padx=15,
                pady=4,
                command=lambda: self.start_level(index)
            )
            play_btn.pack()
        else:
            play_btn = tk.Button(
                inner_frame,
                text="ИГРАТЬ",
                font=("Arial", 10, "bold"),
                bg=self.colors['accent'],
                fg='#ffffff',
                relief=tk.FLAT,
                cursor="hand2",
                padx=20,
                pady=5,
                command=lambda: self.start_level(index)
            )
            play_btn.pack()
        
        # Эффект наведения
        def on_enter(e):
            card.config(bg=self.colors['card_hover'])
            inner_frame.config(bg=self.colors['card_hover'])
            name_label.config(bg=self.colors['card_hover'])
            size_label.config(bg=self.colors['card_hover'])
            difficulty_label.config(bg=self.colors['card_hover'])
            if is_completed:
                status_label.config(bg=self.colors['card_hover'])
        
        def on_leave(e):
            card.config(bg=self.colors['card'])
            inner_frame.config(bg=self.colors['card'])
            name_label.config(bg=self.colors['card'])
            size_label.config(bg=self.colors['card'])
            difficulty_label.config(bg=self.colors['card'])
            if is_completed:
                status_label.config(bg=self.colors['card'])
        
        card.bind("<Enter>", on_enter)
        card.bind("<Leave>", on_leave)
        inner_frame.bind("<Enter>", on_enter)
        inner_frame.bind("<Leave>", on_leave)
    
    def create_modern_button(self, parent, text, command, width=20, height=2, variant="primary"):
        """Создание стильной кнопки"""
        if variant == "primary":
            bg_color = self.colors['accent']
            hover_color = self.colors['accent_hover']
            fg_color = '#ffffff'
        else:
            bg_color = self.colors['button']
            hover_color = self.colors['button_hover']
            fg_color = self.colors['text']
        
        btn = tk.Button(
            parent,
            text=text,
            command=command,
            font=("Arial", 12, "bold"),
            bg=bg_color,
            fg=fg_color,
            relief=tk.FLAT,
            cursor="hand2",
            width=width,
            height=height
        )
        
        def on_enter(e):
            btn.config(bg=hover_color)
        
        def on_leave(e):
            btn.config(bg=bg_color)
        
        btn.bind("<Enter>", on_enter)
        btn.bind("<Leave>", on_leave)
        
        return btn
    
    def show_start_screen(self):
        """Показ стартового экрана"""
        self.clear_content()
        self.current_screen = "start"
        
        center_frame = tk.Frame(self.content_area, bg=self.colors['bg'])
        center_frame.pack(expand=True, fill=tk.BOTH)
        
        buttons = [
            ("СТАРТ", lambda: self.show_levels(), "primary"),
            ("НАСТРОЙКИ", lambda: self.show_settings(), "secondary"),
            ("ВЫХОД", self.root.quit, "secondary")
        ]
        
        for text, command, variant in buttons:
            btn = self.create_modern_button(center_frame, text, command, width=20, height=1, variant=variant)
            btn.pack(pady=8)
    
    def show_levels(self):
        """Показ списка уровней в виде сетки (как на картинке)"""
        self.clear_content()
        self.current_screen = "levels"
        
        # Верхняя панель с кнопкой назад
        top_bar = tk.Frame(self.content_area, bg=self.colors['bg'], height=40)
        top_bar.pack(fill=tk.X, pady=(0, 10))
        top_bar.pack_propagate(False)
        
        # Кнопка "◀ Назад"
        back_button = tk.Button(
            top_bar,
            text="◀ НАЗАД",
            command=self.show_start_screen,
            font=("Arial", 10, "bold"),
            bg=self.colors['button'],
            fg=self.colors['text'],
            relief=tk.FLAT,
            cursor="hand2",
            padx=12,
            pady=4
        )
        back_button.pack(side=tk.LEFT)
        
        def on_back_enter(e):
            back_button.config(bg=self.colors['button_hover'])
        
        def on_back_leave(e):
            back_button.config(bg=self.colors['button'])
        
        back_button.bind("<Enter>", on_back_enter)
        back_button.bind("<Leave>", on_back_leave)
        
        # Заголовок
        tk.Label(
            self.content_area,
            text="УРОВНИ",
            font=("Arial", 20, "bold"),
            fg=self.colors['text'],
            bg=self.colors['bg']
        ).pack(pady=(0, 15))
        
        # Контейнер для карточек с прокруткой
        cards_container = tk.Frame(self.content_area, bg=self.colors['bg'])
        cards_container.pack(fill=tk.BOTH, expand=True)
        
        # Canvas для скроллинга
        canvas = tk.Canvas(cards_container, bg=self.colors['bg'], highlightthickness=0)
        scrollbar = ttk.Scrollbar(cards_container, orient="vertical", command=canvas.yview)
        
        scrollable_frame = tk.Frame(canvas, bg=self.colors['bg'])
        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        
        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw", width=canvas.winfo_reqwidth())
        canvas.configure(yscrollcommand=scrollbar.set)
        
        # Создаем сетку карточек (3 колонки)
        row_frame = None
        for i, level in enumerate(self.levels):
            if i % 3 == 0:
                row_frame = tk.Frame(scrollable_frame, bg=self.colors['bg'])
                row_frame.pack(fill=tk.X, pady=5)
            self.create_level_card_grid(row_frame, level, i)
        
        # Добавляем пустые места для выравнивания
        if row_frame and len(self.levels) % 3 != 0:
            for _ in range(3 - (len(self.levels) % 3)):
                empty = tk.Frame(row_frame, width=180, height=160, bg=self.colors['bg'])
                empty.pack(side=tk.LEFT, padx=10, pady=10)
                empty.pack_propagate(False)
        
        # Обновляем ширину canvas
        def update_width(event):
            canvas.itemconfig(1, width=event.width)
        
        canvas.bind("<Configure>", update_width)
        
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
    
