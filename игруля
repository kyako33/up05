    def draw_game_grid(self, parent):
        """Отрисовка игровой сетки"""
        max_row_hints = max(len(hints) for hints in self.rows_hints)
        max_col_hints = max(len(hints) for hints in self.cols_hints)
        
        hint_offset_x = max_col_hints * self.cell_size
        hint_offset_y = max_row_hints * self.cell_size
        
        total_width = hint_offset_x + self.cols * self.cell_size
        total_height = hint_offset_y + self.rows * self.cell_size
        
        canvas = tk.Canvas(
            parent,
            width=total_width + 2,
            height=total_height + 2,
            bg=self.colors['grid_bg'],
            highlightthickness=1,
            highlightbackground=self.colors['grid_line']
        )
        canvas.pack(expand=True)
        
        # Подсказки строк
        for i, hints in enumerate(self.rows_hints):
            row_has_error = self.check_row_errors(i)
            
            for j, hint in enumerate(reversed(hints)):
                x = hint_offset_x - (j + 1) * self.cell_size + self.cell_size // 2
                y = hint_offset_y + i * self.cell_size + self.cell_size // 2
                
                if row_has_error and self.show_hints:
                    cross_size = self.cell_size // 3
                    canvas.create_line(
                        x - cross_size, y - cross_size,
                        x + cross_size, y + cross_size,
                        fill=self.colors['error'], width=2
                    )
                    canvas.create_line(
                        x + cross_size, y - cross_size,
                        x - cross_size, y + cross_size,
                        fill=self.colors['error'], width=2
                    )
                else:
                    canvas.create_text(x, y, text=str(hint), font=("Arial", self.cell_size//3),
                                      fill=self.colors['text'])
        
        # Подсказки столбцов
        for j, hints in enumerate(self.cols_hints):
            col_has_error = self.check_col_errors(j)
            
            for i, hint in enumerate(reversed(hints)):
                x = hint_offset_x + j * self.cell_size + self.cell_size // 2
                y = hint_offset_y - (i + 1) * self.cell_size + self.cell_size // 2
                
                if col_has_error and self.show_hints:
                    cross_size = self.cell_size // 3
                    canvas.create_line(
                        x - cross_size, y - cross_size,
                        x + cross_size, y + cross_size,
                        fill=self.colors['error'], width=2
                    )
                    canvas.create_line(
                        x + cross_size, y - cross_size,
                        x - cross_size, y + cross_size,
                        fill=self.colors['error'], width=2
                    )
                else:
                    canvas.create_text(x, y, text=str(hint), font=("Arial", self.cell_size//3),
                                      fill=self.colors['text'])
        
        # Сетка и ячейки
        for i in range(self.rows):
            for j in range(self.cols):
                x1 = hint_offset_x + j * self.cell_size
                y1 = hint_offset_y + i * self.cell_size
                x2 = x1 + self.cell_size
                y2 = y1 + self.cell_size
                
                if self.user_grid[i][j] == 1:
                    fill_color = self.colors['grid_cell']
                else:
                    fill_color = self.colors['grid_bg']
                
                rect = canvas.create_rectangle(
                    x1, y1, x2, y2,
                    fill=fill_color,
                    outline=self.colors['grid_line'],
                    width=1
                )
                
                canvas.tag_bind(rect, "<Button-1>", lambda e, r=i, c=j: self.left_click(r, c))
                canvas.tag_bind(rect, "<Button-3>", lambda e, r=i, c=j: self.right_click(r, c))
    
    def left_click(self, row, col):
        """Левая кнопка - закраска"""
        if self.user_grid[row][col] == 1:
            self.user_grid[row][col] = 0
        else:
            self.user_grid[row][col] = 1
        self.show_game_screen()
    
    def right_click(self, row, col):
        """Правая кнопка - очистка"""
        if self.user_grid[row][col] == 1:
            self.user_grid[row][col] = 0
        self.show_game_screen()
    
    def reset_level(self):
        """Сброс уровня"""
        self.user_grid = [[0 for _ in range(self.cols)] for _ in range(self.rows)]
        self.show_game_screen()
    
    def check_solution(self):
        """Проверка решения"""
        correct = True
        for i in range(self.rows):
            for j in range(self.cols):
                if self.grid_data[i][j] == 1 and self.user_grid[i][j] != 1:
                    correct = False
                    break
                elif self.grid_data[i][j] == 0 and self.user_grid[i][j] == 1:
                    correct = False
                    break
            if not correct:
                break
        
        if correct:
            level_id = str(self.current_level['id'])
            if level_id not in self.completed_levels:
                self.completed_levels[level_id] = {
                    'name': self.current_level['name'],
                    'riddle': self.current_level['riddle']
                }
                self.save_completed_levels()
            
            self.show_riddle_screen()
        else:
            messagebox.showerror("Ошибка", "❌ Решение неверное! Попробуйте еще раз.")
    
