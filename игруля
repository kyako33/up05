        self.current_theme = theme
        self.setup_styles()
        
        # Обновляем цвета всех фреймов
        self.root.configure(bg=self.colors['bg'])
        self.main_container.configure(bg=self.colors['bg'])
        self.header.configure(bg=self.colors['bg'])
        self.title.configure(bg=self.colors['bg'], fg=self.colors['accent'])
        self.content_area.configure(bg=self.colors['bg'])
        
        # Перерисовываем текущий экран
        if self.current_screen == "start":
            self.show_start_screen()
        elif self.current_screen == "levels":
